# Statistiques de visite Umami (https://cloud.umami.is)
# Copier ce fichier en .env.local (en local) ou ajouter ces variables dans Vercel > Settings > Environment Variables.

# ID du site, visible dans Umami > Settings > Websites > Edit
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Facultatif : ne compter que les visites sur le vrai domaine (ignore localhost)
NEXT_PUBLIC_UMAMI_DOMAINS=cedric-kaze.vercel.app
